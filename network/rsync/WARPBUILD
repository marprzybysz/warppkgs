pkgname=rsync
pkgver=3.3.0
description="Szybkie narzędzie do synchronizacji plików lokalnie i przez sieć"
arch=x86_64
license=GPL-3.0
deps=glibc,openssl,zlib,popt,libssh2
makedeps=gcc,make,autoconf,pkg-config,python3
source=https://download.samba.org/pub/rsync/src/rsync-3.3.0.tar.gz
sha256=7399e9a6708c32d678a72a63219e96f23be0be2336e50fd1348498d07041df90

build() {
    ./configure --prefix=/usr \
                --with-included-popt=no \
                --with-included-zlib=no
    make $MAKEFLAGS
}

package() {
    make DESTDIR="$DESTDIR" install
}
