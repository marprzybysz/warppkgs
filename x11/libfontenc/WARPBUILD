pkgname=libfontenc
pkgver=1.1.8
description="X.Org font encoding library"
arch=x86_64
license=MIT
deps=glibc,zlib
makedeps=gcc,make,pkg-config
source=https://xorg.freedesktop.org/releases/individual/lib/libfontenc-1.1.8.tar.xz
sha256=7b02c3d405236e0d86806b1de9d6868fe60c313628b38350b032914aa4fd14c6

build() {
    ./configure --prefix=/usr --disable-static
    make $MAKEFLAGS
}

package() {
    make DESTDIR="$DESTDIR" install
}
