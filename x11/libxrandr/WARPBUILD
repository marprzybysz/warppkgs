pkgname=libxrandr
pkgver=1.5.4
description="X11 RandR extension library"
arch=x86_64
license=MIT
deps=glibc,libx11,libxext,libxrender
makedeps=gcc,make,pkg-config,xorg-util-macros
source=https://xorg.freedesktop.org/archive/individual/lib/libXrandr-1.5.4.tar.xz
sha256=1ad5b065375f4a85915aa60611cc6407c060492a214d7f9daf214be752c3b4d3

build() {
    ./configure --prefix=/usr --disable-static
    make $MAKEFLAGS
}

package() {
    make DESTDIR="$DESTDIR" install
}
