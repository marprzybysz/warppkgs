pkgname=libxi
pkgver=1.8.2
description="X11 Input extension library"
arch=x86_64
license=MIT
deps=glibc,libx11,libxext,libxfixes
makedeps=gcc,make,pkg-config,xorg-util-macros
source=https://xorg.freedesktop.org/archive/individual/lib/libXi-1.8.2.tar.xz
sha256=d0e0555e53d6e2114eabfa44226ba162d2708501a25e18d99cfb35c094c6c104

build() {
