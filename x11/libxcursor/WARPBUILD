description="X11 cursor management library"
arch=x86_64
license=MIT
deps=glibc,libx11,libxfixes,libxrender
makedeps=gcc,make,pkg-config,xorg-util-macros
source=https://xorg.freedesktop.org/archive/individual/lib/libXcursor-1.2.2.tar.xz
