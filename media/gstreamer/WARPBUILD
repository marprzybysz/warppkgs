pkgname=gstreamer
pkgver=1.24.10
description="GStreamer multimedia framework"
arch=x86_64
license=LGPL-2.0
deps=glibc,glib,libxml2
makedeps=gcc,meson,ninja,pkg-config,flex,bison,python3
source=https://gstreamer.freedesktop.org/src/gstreamer/gstreamer-1.24.10.tar.xz
sha256=9fc45b1a332e8f812f09e95c281cd75969f6d1682d062a815db0e7bc047518fd

build() {
    meson setup build --prefix=/usr \
          -Dgst_debug=true \
          -Dtests=disabled \
          -Dexamples=disabled \
          -Dbenchmarks=disabled
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
