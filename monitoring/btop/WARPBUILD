pkgname=btop
pkgver=1.4.0
description="Nowoczesny monitor zasobów — CPU, RAM, sieć, dysk w TUI"
arch=x86_64
license=Apache-2.0
deps=glibc,libcap
makedeps=gcc,cmake,ninja
source=https://github.com/aristocratos/btop/archive/refs/tags/v1.4.0.tar.gz
sha256=ac0d2371bf69d5136de7e9470c6fb286cbee2e16b4c7a6d2cd48a14796e86650

build() {
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
