pkgname=libxslt
pkgver=1.1.42
description="XSLT processing library"
arch=x86_64
license=MIT
deps=glibc,libxml2,libgcrypt
makedeps=gcc,make,pkg-config
source=https://download.gnome.org/sources/libxslt/1.1/libxslt-1.1.42.tar.xz
sha256=85ca62cac0d41fc77d3f6033da9df6fd73d20ea2fc18b0a3609ffb4110e1baeb

build() {
    ./configure --prefix=/usr --disable-static --without-python
    make $MAKEFLAGS
}

package() {
    make DESTDIR="$DESTDIR" install
}
