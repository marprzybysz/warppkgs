pkgname=wayland
pkgver=1.23.0
description="Wayland display protocol core library"
arch=x86_64
license=MIT
deps=glibc,libxml2,libffi
makedeps=gcc,meson,ninja,pkg-config
source=https://gitlab.freedesktop.org/wayland/wayland/-/releases/1.23.0/downloads/wayland-1.23.0.tar.xz
sha256=05b3e1574d3e67626b5974f862f36b5b427c7ceeb965cb36a4e6c2d342e45ab2

build() {
    meson setup build --prefix=/usr -Ddocumentation=false -Dtests=false
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
