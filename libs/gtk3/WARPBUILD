pkgname=gtk3
pkgver=3.24.43
description="GTK3 graphical toolkit"
arch=x86_64
license=LGPL-2.1
deps=glibc,glib,gdk-pixbuf,pango,cairo,harfbuzz,fontconfig,freetype,libxkbcommon,at-spi2-core,libx11,libxext,libxrender,libxcomposite,libxdamage,libxfixes,dbus
makedeps=gcc,meson,ninja,pkg-config,python3,gobject-introspection
source=https://ftp.gnome.org/pub/gnome/sources/gtk+/3.24/gtk+-3.24.43.tar.xz
sha256=7e04f0648515034b806b74ae5d774d87cffb1a2a96c468cb5be476d51bf2f3c7

build() {
    export PKG_CONFIG_PATH=/usr/lib64/pkgconfig:/usr/lib/pkgconfig
    export LD_LIBRARY_PATH=/usr/lib64:/usr/lib
    meson setup --wrap-mode=nofallback build \
        --prefix=/usr \
        --buildtype=release \
        -Dx11_backend=true \
        -Dwayland_backend=false \
        -Dbroadway_backend=false \
        -Dintrospection=false \
        -Ddemos=false \
        -Dexamples=false \
        -Dtests=false \
        -Dman=false
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
