pkgname=popt
pkgver=1.19
description="Biblioteka do parsowania opcji wiersza poleceń (używana przez rsync)"
arch=x86_64
license=MIT
deps=glibc
makedeps=gcc,make,autoconf,automake,libtool
source=https://github.com/rpm-software-management/popt/archive/refs/tags/popt-1.19-release.tar.gz
sha256=6eb40d650526cb9fe63eb4415bcecdf9cf306f7556e77eff689abc5a44670060

build() {
    ./configure --prefix=/usr --disable-static
    make $MAKEFLAGS
}

package() {
    make DESTDIR="$DESTDIR" install
}
