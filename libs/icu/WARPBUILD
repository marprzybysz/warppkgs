pkgname=icu
pkgver=75.1
description="International Components for Unicode"
arch=x86_64
license=ICU
deps=glibc
makedeps=gcc,g++,make
source=https://github.com/unicode-org/icu/releases/download/release-75-1/icu4c-75_1-src.tgz
sha256=cb968df3e4d2e87e8b11c49a5d01c787bd13b9545280fc6642f826527618caef

build() {
    cd source
    ./configure --prefix=/usr
    make $MAKEFLAGS
}

package() {
    cd source
    make DESTDIR="$DESTDIR" install
}
