pkgname=libtiff
pkgver=4.6.0
description="TIFF image format library"
arch=x86_64
license=MIT
deps=glibc,libjpeg-turbo,zlib
makedeps=gcc,cmake,ninja
source=https://download.osgeo.org/libtiff/tiff-4.6.0.tar.gz
sha256=88b3979e6d5c7e32b50d7ec72fb15af724f6ab2cbf7e10880c360a77e4b5d99a

build() {
    cmake -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
