pkgname=wayland-protocols
pkgver=1.36
description="Wayland protocol extensions"
arch=x86_64
license=MIT
deps=wayland
makedeps=meson,ninja,pkg-config
source=https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/1.36/downloads/wayland-protocols-1.36.tar.xz
sha256=71fd4de05e79f9a1ca559fac30c1f8365fa10346422f9fe795f74d77b9ef7e92

build() {
