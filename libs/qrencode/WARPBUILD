pkgname=qrencode
pkgver=4.1.1
description="QR Code encoding library"
arch=x86_64
license=LGPL-2.1
deps=glibc,libpng
makedeps=gcc,cmake,ninja,pkg-config
source=https://github.com/fukuchi/libqrencode/archive/refs/tags/v4.1.1.tar.gz
sha256=5385bc1b8c2f20f3b91d258bf8ccc8cf62023935df2d2676b5b67049f31a049c

build() {
    cmake -GNinja \
          -DCMAKE_INSTALL_PREFIX=/usr \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_SHARED_LIBS=ON \
          -DWITH_TOOLS=YES \
          -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
