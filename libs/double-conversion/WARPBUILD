pkgname=double-conversion
pkgver=3.3.0
description="Binary-decimal and decimal-binary conversion routines"
arch=x86_64
license=BSD-3-Clause
deps=glibc
makedeps=gcc,g++,cmake,make
source=https://github.com/google/double-conversion/archive/refs/tags/v3.3.0.tar.gz
sha256=04ec44461850abbf33824da84978043b22554896b552c5fd11a9c5ae4b4d296e

build() {
    cmake -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON
    cmake --build build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" cmake --install build
}
