pkgname=libx11
pkgver=1.8.10
description="X11 client-side library"
arch=x86_64
license=MIT
deps=glibc,libxcb
makedeps=gcc,make,pkgconf,xorg-util-macros
source=https://xorg.freedesktop.org/releases/individual/lib/libX11-1.8.10.tar.xz
sha256=2b3b3dad9347db41dca56beb7db5878f283bde1142f04d9f8e478af435dfdc53

build() {
    ./configure --prefix=/usr --disable-static
    make $MAKEFLAGS
}

package() {
    make DESTDIR="$DESTDIR" install
}
