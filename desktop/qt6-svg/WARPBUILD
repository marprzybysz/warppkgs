pkgname=qt6-svg
pkgver=6.8.1
description="Qt6 SVG support"
arch=x86_64
license=LGPL-3.0
deps=qt6-base
makedeps=gcc,cmake,ninja
source=https://download.qt.io/official_releases/qt/6.8/6.8.1/submodules/qtsvg-everywhere-src-6.8.1.tar.xz
sha256=3d0de73596e36b2daa7c48d77c4426bb091752856912fba720215f756c560dd0

build() {
    cmake -GNinja \
          -DCMAKE_INSTALL_PREFIX=/usr \
          -DCMAKE_BUILD_TYPE=Release \
          -DQT_BUILD_EXAMPLES=OFF \
          -DQT_BUILD_TESTS=OFF \
          -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
