pkgname=kitemviews
pkgver=6.7.0
description="Widget add-ons for Qt Model/View"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/frameworks/6.7/kitemviews-6.7.0.tar.xz
sha256=5e635162993c9f1e15f3a1109ca3227d0d2ce57cf7070615651b65cf790db049

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
