pkgname=karchive
pkgver=6.7.0
description="File compression/decompression framework"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,zlib,bzip2,xz-utils,zstd
makedeps=gcc,cmake,ninja,extra-cmake-modules
source=https://download.kde.org/stable/frameworks/6.7/karchive-6.7.0.tar.xz
sha256=eb4243e627f51f1224a99af5d0a6f8e309f9e5dbb7478f7a78e34e2b8541398a

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
