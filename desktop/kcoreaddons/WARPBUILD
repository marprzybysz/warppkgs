pkgname=kcoreaddons
pkgver=6.7.0
description="Core Qt extensions and addons"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/frameworks/6.7/kcoreaddons-6.7.0.tar.xz
sha256=48511e9dab1f2e80b3c4822bb87c2e981186de3b8977d92082d34d003b1283c5

build() {
    cmake -GNinja \
          -DCMAKE_INSTALL_PREFIX=/usr \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_TESTING=OFF \
          -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
