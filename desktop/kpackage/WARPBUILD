pkgname=kpackage
pkgver=6.7.0
description="Package management for KDE resources"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,kconfig,kcoreaddons
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/frameworks/6.7/kpackage-6.7.0.tar.xz
sha256=916c11f5972760d9a5039643fbc55cde9d11ec18f278d3d63793336ffa442865

build() {
    cmake -GNinja \
          -DCMAKE_INSTALL_PREFIX=/usr \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_TESTING=OFF \
          -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
