pkgname=kpty
pkgver=6.7.0
description="Interfacing with pseudo terminal devices"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,kcoreaddons,ki18n
makedeps=gcc,cmake,ninja,extra-cmake-modules
source=https://download.kde.org/stable/frameworks/6.7/kpty-6.7.0.tar.xz
sha256=42cc1b1f70ee0bdacd26812857d31047d218e1f585ac35fe9165908501a9946a

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
