pkgname=kwidgetsaddons
pkgver=6.7.0
description="Addons for Qt Widgets"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/frameworks/6.7/kwidgetsaddons-6.7.0.tar.xz
sha256=bd36342893863e6110c5f1245f8ae0b3a338275f4eaf124b15585d2fe492329a

build() {
    cmake -GNinja \
          -DCMAKE_INSTALL_PREFIX=/usr \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_TESTING=OFF \
          -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
