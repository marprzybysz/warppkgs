pkgname=kidletime
pkgver=6.7.0
description="User and system idle time reporting"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,wayland,plasma-wayland-protocols
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-wayland
source=https://download.kde.org/stable/frameworks/6.7/kidletime-6.7.0.tar.xz
sha256=60a6c70387b63e61147029ce57f170237271411630a3372a0e8d7240b8006aaf

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
