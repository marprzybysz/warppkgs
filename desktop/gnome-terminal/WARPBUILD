pkgname=gnome-terminal
pkgver=3.54.0
description="GNOME terminal emulator"
arch=x86_64
license=GPL-3.0
deps=glibc,glib,gtk4,libadwaita,vte,dbus
makedeps=gcc,meson,ninja,pkg-config,python3,itstool
source=https://gitlab.gnome.org/GNOME/gnome-terminal/-/archive/3.54.0/gnome-terminal-3.54.0.tar.gz
sha256=77370b4a00d0cda9ef339ff3aa809d266f3b937f00875176904c5bbefb76ae79

build() {
    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -Ddocs=false \
        -Dnautilus_extension=false
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
