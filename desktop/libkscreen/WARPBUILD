pkgname=libkscreen
pkgver=6.2.5
description="KDE screen management library"
arch=x86_64
license=GPL-2.0
deps=glibc,qt6-base,qt6-wayland,kconfig,kcoreaddons,wayland
makedeps=gcc,cmake,ninja,extra-cmake-modules,plasma-wayland-protocols
source=https://download.kde.org/stable/plasma/6.2.5/libkscreen-6.2.5.tar.xz
sha256=5edaf6fa2eed6ddcef4bc479f4bb15d3481acb60adf0150e9f9a1382607bbcb8

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
