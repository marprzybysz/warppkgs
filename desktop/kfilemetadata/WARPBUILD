pkgname=kfilemetadata
pkgver=6.7.0
description="Library for extracting file metadata"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,kconfig,kcoreaddons,ki18n,karchive
makedeps=gcc,cmake,ninja,extra-cmake-modules
source=https://download.kde.org/stable/frameworks/6.7/kfilemetadata-6.7.0.tar.xz
sha256=a6242a79e672b523ebf1b2554ebf83aca7a9d5065929b6f152731e9851d008d0

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
