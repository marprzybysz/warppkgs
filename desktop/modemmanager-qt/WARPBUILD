pkgname=modemmanager-qt
pkgver=6.7.0
description="Qt wrapper for ModemManager DBus API"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base
makedeps=gcc,cmake,ninja,extra-cmake-modules
source=https://download.kde.org/stable/frameworks/6.7/modemmanager-qt-6.7.0.tar.xz
sha256=fc45dcd8ada243baf7900099062f312b677bf694f88f36746d534afe907bf8f3

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
