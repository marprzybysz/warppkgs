pkgname=networkmanager-qt
pkgver=6.7.0
description="Qt wrapper for NetworkManager DBus API"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,networkmanager,dbus
makedeps=gcc,cmake,ninja,extra-cmake-modules
source=https://download.kde.org/stable/frameworks/6.7/networkmanager-qt-6.7.0.tar.xz
sha256=563231644587918c950bcbe5fda0bf6a35e97a12f6b0e9bf9eaa4ce3141d3122

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
