pkgname=kjobwidgets
pkgver=6.7.0
description="Widgets for KIO jobs"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,kwidgetsaddons,kcoreaddons
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/frameworks/6.7/kjobwidgets-6.7.0.tar.xz
sha256=16d7e7ab54235d6fa1eb213d3d637182e22fcbdbcb7b4b14032430a02a2f888a

build() {
    cmake -GNinja \
          -DCMAKE_INSTALL_PREFIX=/usr \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_TESTING=OFF \
          -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
