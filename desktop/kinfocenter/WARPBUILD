pkgname=kinfocenter
pkgver=6.2.5
description="KDE system information center"
arch=x86_64
license=GPL-2.0
deps=glibc,qt6-base,qt6-declarative,kconfig,kcoreaddons,ki18n,kio,kservice,kirigami,qqc2-desktop-style,solid,libplasma,plasma5support
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/plasma/6.2.5/kinfocenter-6.2.5.tar.xz
sha256=9ed87edb3a24256189f8dc79c821b8f45589aab7032d8dde78d5d94cf0639ff9

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
