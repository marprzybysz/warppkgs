pkgname=kconfigwidgets
pkgver=6.7.0
description="Widgets for configuration dialogs"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,kconfig,kcolorscheme,kcodecs,kguiaddons,ki18n,kwidgetsaddons
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools,kdoctools
source=https://download.kde.org/stable/frameworks/6.7/kconfigwidgets-6.7.0.tar.xz
sha256=c079c67c578930baafae241bb4f252c63fdd125e44f1fb952e39bae3c9859cd1

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
