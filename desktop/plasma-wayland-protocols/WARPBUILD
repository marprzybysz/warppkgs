pkgname=plasma-wayland-protocols
pkgver=1.14.0
description="Plasma-specific Wayland protocols"
arch=x86_64
license=LGPL-2.1
deps=glibc
makedeps=cmake,ninja,extra-cmake-modules
source=https://download.kde.org/stable/plasma-wayland-protocols/plasma-wayland-protocols-1.14.0.tar.xz
sha256=1a4385ecfc79f7589f07381cab11c3ff51f6e2fa4b73b78600d6ad096394bf81

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
