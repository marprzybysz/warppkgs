pkgname=kxmlgui
pkgver=6.7.0
description="Framework for managing menu and toolbar actions"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,kconfig,kconfigwidgets,kcoreaddons,kglobalaccel,kguiaddons,ki18n,kiconthemes,kitemviews,kwidgetsaddons
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/frameworks/6.7/kxmlgui-6.7.0.tar.xz
sha256=a451c16d70a591de13973079115f35905e3c42302f5c8c8ae3ec75d76a06fca1

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
