pkgname=qqc2-desktop-style
pkgver=6.7.0
description="Qt Quick Controls 2 style for desktop"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,qt6-declarative,kconfig,kcolorscheme,kiconthemes,kirigami,kcoreaddons
makedeps=gcc,cmake,ninja,extra-cmake-modules
source=https://download.kde.org/stable/frameworks/6.7/qqc2-desktop-style-6.7.0.tar.xz
sha256=b6602d21ba891a63461827aa4513946aef0d8e0141f4a831aafb2c4d2e3fb329

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
