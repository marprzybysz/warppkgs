pkgname=kcompletion
pkgver=6.7.0
description="Text completion helpers and widgets"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,kconfig,kwidgetsaddons,kcodecs
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/frameworks/6.7/kcompletion-6.7.0.tar.xz
sha256=7ed5a96ab0d2ab17bb521ecaaf44d6ec6b7c9a3d6e09403360ba49b24d94560f

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
