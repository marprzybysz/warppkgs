pkgname=kcmutils
pkgver=6.7.0
description="Utilities for KDE System Settings modules"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,qt6-declarative,kcoreaddons,kconfig,kservice,ki18n,kio,kxmlgui,kwidgetsaddons,kconfigwidgets,kguiaddons,kiconthemes
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/frameworks/6.7/kcmutils-6.7.0.tar.xz
sha256=4118388f8f62aa5f1139ed78823b58b009e9ebf7f3755e9a94ab5f9eba644cbe

build() {
    cmake -GNinja \
          -DCMAKE_INSTALL_PREFIX=/usr \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_TESTING=OFF \
          -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
