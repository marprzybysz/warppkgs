pkgname=kitemmodels
pkgver=6.7.0
description="Models for Qt Model/View framework"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base
makedeps=gcc,cmake,ninja,extra-cmake-modules
source=https://download.kde.org/stable/frameworks/6.7/kitemmodels-6.7.0.tar.xz
sha256=0aa0205323baf2d519ebb8f96ce7ed5524a8164a7440d905f977418bfbe6d349

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
