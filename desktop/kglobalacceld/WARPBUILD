pkgname=kglobalacceld
pkgver=6.2.5
description="Daemon for global keyboard shortcuts"
arch=x86_64
license=GPL-2.0
deps=glibc,qt6-base,kconfig,kcoreaddons,kcrash,kdbusaddons,kglobalaccel,kio,kservice
makedeps=gcc,cmake,ninja,extra-cmake-modules
source=https://download.kde.org/stable/plasma/6.2.5/kglobalacceld-6.2.5.tar.xz
sha256=94b5cc3780ca6b074093c487ec9e6c3460f635ae5145780f87c0fe8484d8c6c9

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
