pkgname=kbookmarks
pkgver=6.7.0
description="Bookmarks management library"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,kconfig,kcoreaddons,kwidgetsaddons,kconfigwidgets,kxmlgui
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/frameworks/6.7/kbookmarks-6.7.0.tar.xz
sha256=bd41a39df76515ee34e7df07b2600e1e5b67b1812cc959ec51585f2ebcc56573

build() {
    cmake -GNinja \
          -DCMAKE_INSTALL_PREFIX=/usr \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_TESTING=OFF \
          -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
