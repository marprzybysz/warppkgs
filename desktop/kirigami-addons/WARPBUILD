pkgname=kirigami-addons
pkgver=1.5.0
description="Add-ons for the Kirigami framework"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,qt6-declarative,kirigami,ki18n,kcoreaddons,kconfig
makedeps=gcc,cmake,ninja,extra-cmake-modules
source=https://download.kde.org/stable/kirigami-addons/kirigami-addons-1.5.0.tar.xz
sha256=f9dfd191022b633ea3348f84730d7158a159dfe49668dba0a9e9bd678ac44e54

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
