pkgname=systemsettings
pkgver=6.2.5
description="KDE system settings"
arch=x86_64
license=GPL-2.0
deps=glibc,qt6-base,qt6-declarative,kauth,kconfig,kcoreaddons,kcrash,kdbusaddons,ki18n,kiconthemes,kio,kitemviews,kservice,kwidgetsaddons,kxmlgui,krunner,kirigami,qqc2-desktop-style,plasma-activities
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/plasma/6.2.5/systemsettings-6.2.5.tar.xz
sha256=b5022f294325dbd3da16abefb52a12c018c73a3c78eda032df89173c69abd375

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
