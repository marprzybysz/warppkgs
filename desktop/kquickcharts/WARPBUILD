pkgname=kquickcharts
pkgver=6.7.0
description="Qt Quick module for rendering high-performance charts"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,qt6-declarative
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-declarative,qt6-shadertools
source=https://download.kde.org/stable/frameworks/6.7/kquickcharts-6.7.0.tar.xz
sha256=664047e7b622c0b865d7466817179455fb3851cbb15a8f2c38b8ab9cf85098a4

build() {
    cmake -GNinja \
          -DCMAKE_INSTALL_PREFIX=/usr \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_TESTING=OFF \
          -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
