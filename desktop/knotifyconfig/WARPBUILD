pkgname=knotifyconfig
pkgver=6.7.0
description="Configuration dialog for desktop notifications"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,kconfig,kcoreaddons,ki18n,kio,knotifications
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/frameworks/6.7/knotifyconfig-6.7.0.tar.xz
sha256=4227da7a18f9ba83b34bf54b6d3fc168dc0726bca149d2f89585bb54ab138295

build() {
    cmake -GNinja \
          -DCMAKE_INSTALL_PREFIX=/usr \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_TESTING=OFF \
          -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
