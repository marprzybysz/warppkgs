pkgname=kirigami
pkgver=6.7.0
description="QtQuick based components set"
arch=x86_64
license=LGPL-2.1
deps=glibc,qt6-base,qt6-declarative,qt6-svg
makedeps=gcc,cmake,ninja,extra-cmake-modules,qt6-tools
source=https://download.kde.org/stable/frameworks/6.7/kirigami-6.7.0.tar.xz
sha256=4d645a0374d33b9465e79e3e17170882e2cbda1526f45bc5b6b176dadda77d76

build() {
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -B build
    ninja -C build $MAKEFLAGS
}

package() {
    DESTDIR="$DESTDIR" ninja -C build install
}
