pkgname=mc
pkgver=4.8.32
description="Midnight Commander — dwupanelowy file manager TUI, klasyk"
arch=x86_64
license=GPL-3.0
deps=glibc,ncurses,glib,libssh2,openssl
makedeps=gcc,make,autoconf,automake,pkg-config,glib
source=https://github.com/MidnightCommander/mc/archive/refs/tags/4.8.32.tar.gz
sha256=5b8e6a66b53f67a430296e3e490c00af17cbbb449f6c56f406ff02a11d516ba1

build() {
    ./configure --prefix=/usr \
                --with-screen=ncurses \
                --enable-charset \
                --with-ssh2
    make $MAKEFLAGS
}

package() {
    make DESTDIR="$DESTDIR" install
}
