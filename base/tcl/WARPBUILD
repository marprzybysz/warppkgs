pkgname=tcl
pkgver=8.6.14
description="Tcl scripting language"
arch=x86_64
license=Tcl
deps=glibc,zlib
makedeps=gcc,make
source=https://downloads.sourceforge.net/tcl/tcl8.6.14-src.tar.gz
sha256=5880225babf7954c58d4fb0f5cf6279104ce1cd6aa9b71e9a6322540e1c4de66

build() {
    cd unix
    ./configure --prefix=/usr --mandir=/usr/share/man
    make $MAKEFLAGS
}

package() {
    cd unix
    make DESTDIR="$DESTDIR" install
    ln -sf tclsh8.6 "$DESTDIR/usr/bin/tclsh"
}
