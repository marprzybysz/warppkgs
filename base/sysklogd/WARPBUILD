pkgname=sysklogd
pkgver=2.6.1
description="System logging daemons"
arch=x86_64
license=GPL-2.0
deps=glibc
makedeps=gcc,make
source=https://github.com/troglobit/sysklogd/releases/download/v2.6.1/sysklogd-2.6.1.tar.gz
sha256=e35d5c5f55019976302ac9818890bd6b6858db257506f0e9afaa718a8dee9cc3

build() {
    ./configure --prefix=/usr    \
                --sysconfdir=/etc \
                --without-logger
    make $MAKEFLAGS
}

package() {
    make DESTDIR="$DESTDIR" install
}
