pkgname=procps-ng
pkgver=4.0.4
description="Utilities for monitoring your system and processes"
arch=x86_64
license=GPL-2.0
deps=glibc,ncurses
makedeps=gcc,make,pkg-config
source=https://sourceforge.net/projects/procps-ng/files/Production/procps-ng-4.0.4.tar.xz
sha256=22870d6feb2478adb617ce4f09a787addaf2d260c5a8aa7b17d889a962c5e42e

build() {
    ./configure --prefix=/usr     \
                --disable-static  \
                --disable-kill
    make $MAKEFLAGS
}

package() {
    make DESTDIR="$DESTDIR" install
}
