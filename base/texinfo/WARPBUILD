pkgname=texinfo
pkgver=7.1
description="GNU documentation system"
arch=x86_64
license=GPL-3.0
deps=glibc,perl,ncurses
makedeps=gcc,make
source=https://ftp.gnu.org/gnu/texinfo/texinfo-7.1.tar.xz
sha256=deeec9f19f159e046fdf8ad22231981806dac332cc372f1c763504ad82b30953

build() {
