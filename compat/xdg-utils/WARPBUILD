description="Command-line tools for desktop integration (xdg-open, xdg-mime, etc.)"
arch=x86_64
license=MIT
deps=glibc,bash
makedeps=make,xmlto
source=https://gitlab.freedesktop.org/xdg/xdg-utils/-/archive/v1.2.1/xdg-utils-v1.2.1.tar.gz
