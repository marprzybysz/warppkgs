pkgname=cabextract
pkgver=1.11
description="Tool for extracting Microsoft Cabinet (.cab) files"
arch=x86_64
license=GPL-2.0
deps=glibc,zlib
makedeps=gcc,make
source=https://www.cabextract.org.uk/cabextract-1.11.tar.gz
sha256=b5546db1155e4c718ff3d4b278573604f30dd64c3c5bfd4657cd089b823a3ac6

build() {
    ./configure --prefix=/usr
    make $MAKEFLAGS
}

package() {
    make DESTDIR="$DESTDIR" install
}
