pkgname=automake
pkgver=1.17
description="GNU Automake build system generator"
arch=x86_64
license=GPL-2.0
deps=glibc,autoconf,perl
makedeps=gcc,make
source=https://ftpmirror.gnu.org/automake/automake-1.17.tar.xz
sha256=8920c1fc411e13b90bf704ef9db6f29d540e76d232cb3b2c9f4dc4cc599bd990

build() {
    ./configure --prefix=/usr
    make $MAKEFLAGS
}

package() {
    make DESTDIR="$DESTDIR" install
}
