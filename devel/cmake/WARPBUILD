pkgname=cmake
pkgver=3.30.5
description="Cross-platform build system generator"
arch=x86_64
license=BSD-3-Clause
deps=glibc,openssl,libarchive,ncurses,zlib,expat
makedeps=gcc,g++,make
source=https://github.com/Kitware/CMake/releases/download/v3.30.5/cmake-3.30.5.tar.gz
sha256=9f55e1a40508f2f29b7e065fa08c29f82c402fa0402da839fffe64a25755a86d

build() {
    ./bootstrap --prefix=/usr --parallel=$(nproc)
    make $MAKEFLAGS
}

package() {
    make DESTDIR="$DESTDIR" install
}
